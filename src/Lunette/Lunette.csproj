<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Lunette</AssemblyName>
    <RootNamespace>Lunette</RootNamespace>
    <!-- The only assembly that may use unsafe, and then only in the Lunette.Unsafe helpers (LD005). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Enables the trim/AOT analyzers (IL2xxx/IL3xxx): no reflection or dynamic code in core. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- LUA_SAFE_ACCESS (-p:LuaSafeAccess=true) swaps the whole Lunette.Unsafe family for its bounds-checked twin: exactly one of the two files compiles. -->
  <ItemGroup Condition="'$(LuaSafeAccess)' == 'true'">
    <Compile Remove="Unsafe\Regs.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(LuaSafeAccess)' != 'true'">
    <Compile Remove="Unsafe\RegsSafe.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lunette.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
    <!-- Tracks the public surface: every public member must be listed in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt (RS0016/RS0017). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
